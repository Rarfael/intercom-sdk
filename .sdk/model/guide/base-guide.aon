# Guide

guide: {
  metrics: count: entity: 1
  metrics: count: path: 2
  metrics: count: method: 5

  entity: contact: {
    path: "/contacts": {
      op: create: method: *POST
      op: list: method: *GET
      op: list: transform: res: *("`body.data`")|top
    }
    path: "/contacts/{id}": {
      op: load: method: *GET
      op: remove: method: *DELETE
      op: update: method: *PUT
    }
  }

}